# Dark Gym City Environment Variables

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://darkgymcity.com

# Optional n8n / CRM / Baserow Webhook URL for Leads
# If unconfigured, the website defaults to safe demo mode + direct WhatsApp handoff
NEXT_PUBLIC_LEAD_WEBHOOK_URL=

# Official WhatsApp Number (without + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=919746936105

# Optional Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Optional Meta Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
